# Application
APP_NAME=Adabary News Engine
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# News collection
# This query is sent to GDELT when no query is supplied to /news/collect.
NEWS_QUERY="artificial intelligence OR OpenAI OR ChatGPT OR Anthropic OR Gemini OR NVIDIA OR robotics"
NEWS_COLLECTION_LIMIT=20

# News analysis
# "heuristic" works locally without a key. Set "openai" only after adding an
# API key to your untracked .env file.
ANALYSIS_PROVIDER=heuristic
ANALYSIS_MINIMUM_SCORE=70
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Draft generation
CONTENT_PROVIDER=heuristic
CONTENT_MAX_HASHTAGS=3

# Telegram publishing (leave blank until Phase 6 verification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Phase 7 scheduling: keep both false until you are ready for hands-free posting.
SCHEDULER_ENABLED=false
AUTO_PUBLISH_SCHEDULED=false
AUTO_PUBLISH_BREAKING=false
SCHEDULER_TIMEZONE=Africa/Nairobi

# Multilingual destinations. Create the language-specific channels first, then put
# their public t.me links here. The English channel continues using TELEGRAM_CHANNEL_ID.
TELEGRAM_AMHARIC_CHANNEL_URL=
TELEGRAM_OROMO_CHANNEL_URL=
TELEGRAM_TIGRINYA_CHANNEL_URL=

# Owner control bot and webhook (Phase 7)
TELEGRAM_OWNER_CHAT_ID=
# Use 1-256 characters: A-Z, a-z, 0-9, _ or -
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Database
# Use a unique local password when creating your untracked .env file.
DATABASE_URL=postgresql+psycopg://adabary:replace-with-local-password@localhost:5432/adabary_news

# Docker PostgreSQL initialization (used by docker-compose)
POSTGRES_DB=adabary_news
POSTGRES_USER=adabary
POSTGRES_PASSWORD=replace-with-local-password
